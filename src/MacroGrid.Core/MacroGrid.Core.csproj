<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Only a Debug build (a server built from source by a developer) may load unsigned C# plugins. There is no setting,
         switch or environment variable for it, and a CI check keeps release.yml on Release. See PluginTrustVerifier. -->
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);MACROGRID_UNSIGNED_PLUGINS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MacroGrid.Protocol\MacroGrid.Protocol.csproj" />
    <ProjectReference Include="..\MacroGrid.Plugin.Abstractions\MacroGrid.Plugin.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MacroGrid.Tests" />
    <InternalsVisibleTo Include="macrogrid-plugin" />
  </ItemGroup>
</Project>
