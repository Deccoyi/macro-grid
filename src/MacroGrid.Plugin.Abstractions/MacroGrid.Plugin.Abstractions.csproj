<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- NuGet package metadata. The SDK is no longer published to NuGet (2026-09-29): the official plugins build against a checkout of this
         repository. Packing stays only as the compatibility guard below. The version comes from the repository's Directory.Build.props. -->
    <PackageId>MacroGrid.Plugin.Abstractions</PackageId>
    <Authors>Deccoyi</Authors>
    <Description>Plugin SDK for Macro Grid: the IPlugin entry point, action/variable/settings/icon-pack interfaces and the plugin manifest types that C# plugins compile against. The Macro Grid server supplies the runtime copy of this assembly.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) 2026 Deccoyi</Copyright>
    <PackageReleaseNotes>See https://github.com/Deccoyi/macro-grid/blob/main/docs/CHANGELOG-developer.md for the changes in each SDK version.</PackageReleaseNotes>
    <PackageTags>macrogrid;macro-grid;plugin;sdk;streamdeck;macro-pad</PackageTags>
    <PackageProjectUrl>https://github.com/Deccoyi/macro-grid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Deccoyi/macro-grid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Symbols and reproducible builds. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- IntelliSense docs ship in the package. Not every member is documented yet, so CS1591 stays quiet. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1734</NoWarn>

    <!-- Guards the "no breaking change within a MAJOR" rule (docs/guides/versioning.md): `dotnet pack` (run by CI, never pushed) fetches this baseline
         package from nuget.org (the published versions stay there, unlisted) and fails the build if the new one removed or incompatibly changed a public member. Pinned to
         1.0.0 (the first version under the shared-version scheme) for the whole 1.x line; move it only when 2.0.0 ships. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
