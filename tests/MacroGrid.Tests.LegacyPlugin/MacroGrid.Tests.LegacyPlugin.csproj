<Project Sdk="Microsoft.NET.Sdk">

  <!-- A fixture plugin built against a real, already-published old SDK version (not this repository's current one), used by
       LegacyPluginCompatibilityTests to prove that a binary built before the version-unification (SDK 0.4.0, before macroGrid
       existed) still loads on the current server. Pinned on purpose: never bump this PackageReference. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MacroGrid.Plugin.Abstractions" Version="0.4.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
